# Rendered by tools/render.sh — do not edit.
global:
  scrape_interval: ${SCRAPE_INTERVAL}
  evaluation_interval: ${SCRAPE_INTERVAL}

  # Stamped on every series: keeps project identity if hubs are ever merged.
  external_labels:
    project: ${PROJECT_NAME}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: node-exporter
    static_configs:
      - targets:
          - node-exporter:9100

  - job_name: thanos
    static_configs:
      - targets:
          - thanos-sidecar:10902
          - thanos-query:9090
          - thanos-store:10902
          - thanos-compact:10902

  - job_name: loki
    static_configs:
      - targets:
          - loki:3100

  - job_name: grafana
    static_configs:
      - targets:
          - grafana:3000

  - job_name: alertmanager
    static_configs:
      - targets:
          - alertmanager:9093

  - job_name: alloy
    static_configs:
      - targets:
          - alloy:12345

  - job_name: garage
    metrics_path: /metrics
    static_configs:
      - targets:
          - garage:3903

  # Enrolled devices (file_sd — tools/obsdeploy agent register writes files here;
  # adding a device never touches this file)
  - job_name: devices
    file_sd_configs:
      - files:
          - /etc/prometheus/targets/*.yml
        refresh_interval: 30s

  # Remote devices are added here as scrape jobs (pull, Zabbix-style).
