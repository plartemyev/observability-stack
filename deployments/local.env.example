# Deployment vars TEMPLATE — copy to deployments/<site>.env and edit.
# tools/render.sh appends generated secrets (RPC_SECRET, GARAGE_ADMIN_TOKEN,
# S3_ACCESS_KEY/SECRET_KEY, GRAFANA_ADMIN_PASSWORD) to the copy — the vars
# file is the single credential store of a deployment: NEVER commit it.

PROJECT_NAME=mysite
HUB_HOSTNAME=myhub

# versions — pinned at project creation (2026-10-18), bump deliberately
GARAGE_VERSION=v2.4.1
THANOS_VERSION=v0.42.4
PROMETHEUS_VERSION=v3.15.0
ALERTMANAGER_VERSION=v0.34.1
LOKI_VERSION=3.7.8
ALLOY_VERSION=v1.20.1
GRAFANA_VERSION=13.2.4
NODE_EXPORTER_VERSION=v1.12.1
YACE_VERSION=v0.68.0

# layout — BIND_IP should be the tailnet IP on real hubs; 127.0.0.1 for tests
DATA_DIR=./data
BIND_IP=127.0.0.1
QUERY_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
BUCKET_WEB_PORT=9094

# tuning
SCRAPE_INTERVAL=60s
TSDB_RETENTION=48h
RETENTION_RAW=30d
RETENTION_5M=180d
RETENTION_1H=3y
LOKI_RETENTION=30d
S3_BUCKET=thanos
GARAGE_ZONE=dc1
GARAGE_CAPACITY=10G
GRAFANA_ADMIN_USER=admin

# where the repo is cloned on the hub host (remote deployments only)
#HUB_DIR=/opt/observability-stack

# backups — setting BACKUP_DIR adds the backup phase (daily systemd timer)
#BACKUP_DIR=/var/backups/observability
#BACKUP_KEEP=14

# alerts — set both to switch alertmanager from placeholder to Telegram
#TELEGRAM_BOT_TOKEN=123456:ABC...
#TELEGRAM_CHAT_ID=123456789

# cloudwatch — off by default; see stack/yace/config.yaml.tmpl for the schema
YACE_ENABLED=false
#YACE_ACCOUNTS_FILE=/abs/path/to/accounts.yaml
#YACE_AWS_ACCESS_KEY_ID=
#YACE_AWS_SECRET_ACCESS_KEY=
#YACE_AWS_REGION=eu-central-1
